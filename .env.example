# Copy to .env locally; keep the real URI and admin password private.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB=mits_login
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
COOKIE_SECURE=false
# Optional: set both values to create or update one environment-managed admin at startup.
# Leave both blank to disable admin bootstrap.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Server-side PINs required to start Levels 2 and 3. Set privately, then restart.
LEVEL_2_PIN=
LEVEL_3_PIN=
# Level 3 code execution settings
# Runner priority: "local,remote" (default: fast local/container execution with remote fallback) or "remote,local"
RUNNER_PREFERENCE=local,remote
# Remote Judge0 provider (used as primary or secondary fallback)
JUDGE0_URL=https://ce.judge0.com
JUDGE0_AUTH_TOKEN=
JUDGE0_AUTH_HEADER=X-Auth-Token
# Optional: RapidAPI key if using RapidAPI Judge0 (e.g. https://judge0-ce.p.rapidapi.com)
RAPIDAPI_KEY=
# Additional comma-separated fallback Judge0 URLs if primary fails
JUDGE0_FALLBACK_URLS=
# Override language IDs if your Judge0 installation uses a different language catalog.
JUDGE0_LANGUAGE_IDS={"c":50,"cpp":54,"csharp":51,"java":62,"javascript":63,"python":71}
